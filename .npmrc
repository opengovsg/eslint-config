# eslint-plugin-react's peer range still stops at eslint 9.7, even though its
# recommended rules work fine on eslint 10 — see the note in the README and
# https://github.com/jsx-eslint/eslint-plugin-react/issues/3977
#
# This is only needed here, where that plugin and eslint are both root-level
# dependencies, so npm treats the conflict as an error. Consumers get the plugin
# transitively, where npm only warns.
#
# Remove this once that peer range is updated.
legacy-peer-deps=true
